*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Built APKs, copied here under a name that says which version they are.
/dist/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local / sensitive / generated – לא להעלות לגיטהאב
ca-bundle.crt
*.key
.env
.env.*
oauth_credentials.json

# חבילות שהורדו כארכיון (הפרויקט משתמש בתיקיית kosher_dart)
/packages/*.tar.gz

# Flutter/Gradle writes machine-specific SDK paths in every local.properties,
# including examples inside vendored packages. They are never source files.
**/local.properties

# תוצרי בנייה לשחרור – מקומם ב-GitHub Releases ולא במאגר
*.apk
*.aab
sofer_vmone_*_windows.zip

# מפתח החתימה וסיסמאותיו – זהות האפליקציה. לעולם לא במאגר.
# הקובץ לדוגמה (android/key.properties.example) כן נשמר.
android/key.properties
key.properties
*.jks
*.keystore
!android/key.properties.example

# תיקייה כפולה – הקונפיג הרשמי ב־android/app/src/main/res/xml/
/android/app/src/XML/

# רשימות וקבצי פיתוח אישיים (אופציונלי – מחק את השורה אם אתה רוצה לכלול)
GEMINI.MD

